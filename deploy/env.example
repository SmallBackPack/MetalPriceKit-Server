# MetalPriceKit Server —— 环境变量模板
#
# 用法：
#   sudo cp deploy/env.example /etc/metalpricekit-server.env
#   sudo chmod 600 /etc/metalpricekit-server.env
#   sudo vi /etc/metalpricekit-server.env
#
# ⚠️ 这个文件里有服务端私钥和上游 API key，权限必须是 600，owner 必须是运行服务的用户。
# ⚠️ 不要提交进 git。仓库的 .gitignore 已经排除了 .env*。

# ── 必填 ──────────────────────────────────────────────────────

# metals.dev 的 API key。查用量：https://api.metals.dev/usage?api_key=<key>
# （这个查询不扣额度，随时可以查）
METALS_DEV_API_KEY=

# 服务端长期私钥。生成：
#   node -e "console.log('k1:'+require('crypto').randomBytes(32).toString('base64'))"
# 轮换时可以写多把：k1:<base64>,k2:<base64>
MPK_SERVER_KEYS=k1:
# 当前生效的那把，必须在上面那把列表里
MPK_ACTIVE_KID=k1

# ── 强烈建议设置 ──────────────────────────────────────────────

# 不设的话服务端不会强制加密 —— 没有客户端公钥的请求会拿到明文。
# 生产环境必须是 production。
NODE_ENV=production

# ── 额度 ──────────────────────────────────────────────────────

# 每月上游请求硬上限。跟套餐档位对齐：
#   Free   100 次/月 → 约 7 小时刷新一次
#   Copper 2000 次/月（$1.49）→ 约 21 分钟
#   Silver 10000 次/月（$9.99）→ 约 4 分钟
MPK_MONTHLY_BUDGET=100

# 轮询间隔下限（毫秒）。实际间隔 = max(这个值, 额度刹车算出来的间隔)。
# Free 档下刹车会自动把间隔拉到好几小时，这个值基本用不上；
# 升到 Copper/Silver 后它才决定实际刷新频率。
MPK_POLL_INTERVAL_MS=600000

# ── 网络 ──────────────────────────────────────────────────────

PORT=8787
# 只监听本机，公网走 Nginx。
HOST=127.0.0.1

# ── 文件路径 ──────────────────────────────────────────────────

MPK_DATA_DIR=/opt/metalpricekit-server/data
# 通用字段字典。改完即生效，不用重启。
MPK_REMOTE_CONFIG_FILE=/opt/metalpricekit-server/config/remote-config.json

# ── 运营后台 ──────────────────────────────────────────────────
#
# 管理口令。没设的话后台不启用（/admin 一律 503）。
# 生成一条随机串：
#   node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
MPK_ADMIN_TOKEN=

# 后台是否只允许本机（回环地址）访问。
#
# true  = 只接受 127.0.0.1 的请求。**生产环境必须这样。**
# false = 后台跟着服务一起对外开放，只适合开发阶段（纯内网）。
#
# 跟 HOST 是两回事：HOST 决定服务在哪个网卡上监听，
# 这个开关决定后台这一段路径要不要额外卡回环。
MPK_ADMIN_LOCAL_ONLY=true

# 设备标识哈希用的 pepper。
#
# 客户端上报的 deviceId / vendorId 在入库前都用它做 HMAC，库里不留原始设备标识。
# 不设的话服务端会在数据目录里生成一个随机 pepper 存起来（id-pepper 文件）。
#
# ⚠️ pepper 换了 = 所有设备标识的哈希全变 = 所有用户被当成新用户重新计数。
# 多实例部署时所有实例必须用同一个值；单实例用默认生成的就够，但那个文件
# 必须跟数据库一起备份。
MPK_ID_PEPPER=

# ── 其它 ──────────────────────────────────────────────────────

# 启动时立刻拉一次上游（消耗 1 次额度）。没有本地快照时别关。
MPK_FETCH_ON_BOOT=true

# 换上游供应商时改这两个。
# METALS_DEV_BASE_URL=https://api.metals.dev
