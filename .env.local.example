# 本地开发用的环境变量模板。复制成 .env.local 再填。
#
#   copy .env.local.example .env.local
#
# .env.local 已被 .gitignore 排除，密钥不会进版本库。
# 生产环境用 deploy/env.example，路径不一样（那边是 /etc/metalpricekit-server.env）。

# 用 production：强制加密。没有客户端公钥就返回 400，不降级成明文 ——
# 客户端必须真的实现解密才能联调。
# 调试时想看明文，把这行改成 development 再带 X-MPK-Plain: 1 头。
NODE_ENV=production

PORT=8787
HOST=127.0.0.1

# metals.dev 的 API key。查用量（不扣额度）：https://api.metals.dev/usage?api_key=<key>
METALS_DEV_API_KEY=

# 服务端长期私钥。生成：
#   node -e "console.log('k1:'+require('crypto').randomBytes(32).toString('base64'))"
#
# 固定下来 —— 客户端缓存的 bootstrap 公钥不能因重启失效。
MPK_SERVER_KEYS=k1:
MPK_ACTIVE_KID=k1

# 免费档 100 次/月。额度刹车会把实际轮询间隔自动拉长（当前约 6 小时一轮）。
MPK_MONTHLY_BUDGET=100
MPK_POLL_INTERVAL_MS=600000

# 本地重启默认不重新拉上游 —— 启动时先从本地快照恢复，立即就能对外服务。
# 每次启动都烧一次额度太浪费（一个月才 100 次）。
# 想强制刷新一次：改成 true 重启。
MPK_FETCH_ON_BOOT=false

MPK_DATA_DIR=data
MPK_REMOTE_CONFIG_FILE=config/remote-config.json
